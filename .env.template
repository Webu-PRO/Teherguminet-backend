# --- Tomket Dropship (api.tomket.com/dropship/api) ---
# Credentials are the same as the Tomket dropship web interface login.
TOMKET_USERNAME=
TOMKET_PASSWORD=
# ISO 3166-1 alpha-2, lower case. Picks the country-specific feed and pricing.
TOMKET_COUNTRY=hu
TOMKET_API_BASE_URL=
TOMKET_API_TIMEOUT_MS=
# The full feed is multi-megabyte, so it gets its own, longer timeout.
TOMKET_FEED_TIMEOUT_MS=
# Tomket quotes net EUR, the HU region sells in net HUF. The EUR->HUF rate is
# pulled daily from the ECB reference feed (job sync-tomket-fx-rate) and kept
# in store metadata; set TOMKET_EUR_HUF_RATE only to override it by hand.
TOMKET_EUR_HUF_RATE=
# Optional buffer on the ECB mid rate (banks sell EUR above it). Default 0.
TOMKET_EUR_HUF_MARKUP_PERCENT=
# When to refresh the ECB rate (UTC). ECB publishes ~16:00 CET on business days.
TOMKET_FX_SYNC_CRON=30 16 * * *
# Markup on the supplier price. Editable on the admin Tomket page (stored in
# store metadata); this env value is only the fallback when nothing is saved
# there. Without either, the importer refuses to run rather than publish the
# supplier's cost price.
TOMKET_MARGIN_PERCENT=
# Optional: separate markup for the EUR (SK) region; defaults to the above.
TOMKET_MARGIN_PERCENT_EUR=
# Fold the per-piece Tomket shipping fee into the item price (true/false).
TOMKET_INCLUDE_SHIPPING_IN_PRICE=false
# Round HUF prices to this multiple. Default 10.
TOMKET_HUF_ROUNDING=10
# Stock/price sync schedule; Tomket refreshes the stock file every 10 minutes.
TOMKET_STOCK_SYNC_CRON=*/15 * * * *
# Hand the Tomket items of PAID orders to the supplier automatically (creates
# the "Tomket dropship" fulfillment, which places the Tomket API order).
# Editable on the admin Tomket page; default true.
TOMKET_AUTO_FORWARD=true
