# syntax=docker/dockerfile:1.7

FROM node:20-alpine AS base
WORKDIR /server
ENV COREPACK_ENABLE_STRICT=0

RUN apk add --no-cache libc6-compat python3 make g++ \
  && corepack enable \
  && corepack prepare yarn@1.22.22 --activate

FROM base AS deps
COPY package.json yarn.lock .yarnrc.yml ./

RUN --mount=type=cache,id=yarn-cache-backend,target=/usr/local/share/.cache/yarn \
  yarn install --frozen-lockfile --production=false

FROM deps AS builder
COPY . .
ENV NODE_ENV=production

RUN yarn build \
  && if [ -d ".medusa/server/public" ]; then \
    mkdir -p public && cp -R .medusa/server/public/* public/; \
  fi

FROM base AS runner
WORKDIR /server
ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=9000

COPY --from=builder /server /server

EXPOSE 9000

CMD ["sh", "-lc", "yarn medusa db:migrate && if [ \"$RUN_SEED\" = \"true\" ]; then yarn seed || true; fi && yarn start"]
