# syntax=docker/dockerfile:1.7

FROM node:20-alpine AS base
WORKDIR /repo
ENV COREPACK_ENABLE_STRICT=0 \
    PNPM_HOME=/pnpm
ENV PATH="${PNPM_HOME}:${PATH}"
RUN apk add --no-cache libc6-compat python3 make g++ \
  && corepack enable \
  && corepack prepare pnpm@10.12.3 --activate

FROM base AS pruner
COPY . .
RUN pnpm dlx turbo@2.8.20 prune --scope=medusa-starter-default --docker

FROM base AS deps
COPY --from=pruner /repo/out/json/ ./
RUN --mount=type=cache,id=pnpm-store-backend,target=/pnpm/store \
  pnpm install --frozen-lockfile

FROM deps AS builder
COPY --from=pruner /repo/out/full/ ./

ARG TURBO_TEAM
ARG TURBO_TOKEN
ENV NODE_ENV=production \
    TURBO_TEAM=${TURBO_TEAM} \
    TURBO_TOKEN=${TURBO_TOKEN}

RUN --mount=type=cache,id=turbo-cache-backend,target=/repo/.turbo \
  pnpm turbo run build --filter=medusa-starter-default

FROM base AS runner
WORKDIR /repo
ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=9000

COPY --from=builder /repo /repo
WORKDIR /repo/apps/backend

EXPOSE 9000

CMD ["sh", "-lc", "pnpm exec medusa db:migrate && if [ \"$RUN_SEED\" = \"true\" ]; then pnpm seed || true; fi && pnpm start"]
