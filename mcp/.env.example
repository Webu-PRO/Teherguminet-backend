# teherguminet admin MCP — copy to `.env` and fill in.
# `.env` is gitignored (apps/backend/.gitignore matches `.env` anywhere).
#
# Backend URL — production by default. Override to http://localhost:9000 for local dev.
MEDUSA_BACKEND_URL=https://admin.teherguminet.hu

# Pick ONE auth mode:
#
# A) email+password (recommended — JWT auto-refreshes on 401):
MEDUSA_ADMIN_EMAIL=
MEDUSA_ADMIN_PASSWORD=
#
# B) static JWT/PAT (paste a bearer token; you handle expiry):
# MEDUSA_ADMIN_TOKEN=

# Optional: request timeout in ms. Default 15000.
# MEDUSA_MCP_TIMEOUT_MS=15000
