{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "outputs": ["dist/**", ".medusa/**"],
      "env": ["REDIS_URL", "EVENT_BUS_REDIS_URL", "EVENTS_REDIS_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": ["build"]
    },
    "test:unit": {
      "outputs": []
    }
  }
}
