{
  "name": "medusa-starter-default",
  "version": "0.0.1",
  "description": "A starter for Medusa projects.",
  "author": "Medusa (https://medusajs.com)",
  "license": "MIT",
  "keywords": [
    "sqlite",
    "postgres",
    "typescript",
    "ecommerce",
    "headless",
    "medusa"
  ],
  "scripts": {
    "build": "medusa build",
    "turbo:build": "turbo run build --single-package --cache=local:rw,remote:r && if [ ! -d .medusa/server ]; then medusa build; fi",
    "seed": "medusa exec ./src/scripts/seed.ts",
    "pricing:ensure-net": "medusa exec ./src/scripts/ensure-net-price-preferences.ts",
    "localization:backfill": "medusa exec ./src/scripts/backfill-product-localizations.ts",
    "variants:backfill-default-dimensions": "medusa exec ./src/scripts/backfill-default-variant-dimensions.ts",
    "resend:templates:sync": "ts-node --transpile-only ./src/scripts/sync-resend-templates.ts",
    "start": "medusa start",
    "turbo:start": "turbo run start --single-package",
    "dev": "medusa develop",
    "turbo:dev": "turbo run dev --single-package",
    "dev:email": "email dev --dir ./src/modules/resend/emails",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit",
    "turbo:test": "turbo run test:unit --single-package",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@alpha-solutions/medusa-image-alt": "^1.1.0",
    "@medusajs/admin-sdk": "2.13.2",
    "@medusajs/cli": "2.13.2",
    "@medusajs/framework": "2.13.2",
    "@medusajs/medusa": "2.13.2",
    "@mikro-orm/core": "6.4.16",
    "@mikro-orm/knex": "6.4.16",
    "@mikro-orm/migrations": "6.4.16",
    "@mikro-orm/postgresql": "6.4.16",
    "@react-email/components": "0.5.7",
    "@rsc-labs/medusa-store-analytics-v2": "0.1.3",
    "awilix": "^8.0.1",
    "medusa-file-s3": "^1.4.2",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.0",
    "posthog-node": "^4.17.1",
    "resend": "^6.3.0"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.13.2",
    "@mikro-orm/cli": "6.4.16",
    "@swc/core": "1.5.7",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "jest": "^29.7.0",
    "patch-package": "^8.0.0",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-email": "^4.3.2",
    "ts-node": "^10.9.2",
    "turbo": "^2.9.1",
    "typescript": "^5.6.2",
    "vite": "^5.2.11",
    "yalc": "^1.0.0-pre.53"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "yarn@1.22.22"
}
